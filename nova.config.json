{
  "project": {
    "name": {
      "slug": "mrjackyliang",
      "title": "Jacky Liang"
    },
    "description": {
      "short": "Jacky Liang's personal site with versioned script downloads",
      "long": "The personal site of Jacky Liang, a self-taught web developer from New York. Browse the AppleScript utilities, games, scripts, snippets, and TI-84 programs, and download any version of each one."
    },
    "keywords": [
      "personal-site",
      "scripts",
      "applescript",
      "snippets",
      "astro"
    ],
    "legalName": "Jacky Liang",
    "pronouns": "personal",
    "platforms": [
      "nodejs",
      "web"
    ],
    "startingYear": 2014,
    "license": "MIT"
  },
  "entities": [
    {
      "name": "Jacky Liang",
      "email": "hello@mrjackyliang.com",
      "url": "https://www.mrjackyliang.com/",
      "roles": [
        "author"
      ]
    }
  ],
  "emails": {
    "bugs": "bugs@mrjackyliang.com"
  },
  "github": {
    "owner": "mrjackyliang",
    "repo": "mrjackyliang",
    "topics": [
      "personal-site",
      "scripts",
      "applescript",
      "snippets",
      "astro"
    ],
    "features": {
      "issues": true,
      "wiki": false,
      "projects": false,
      "discussions": false,
      "sponsorships": true
    },
    "policies": {
      "visibility": "public",
      "defaultBranch": "main",
      "mergeMethods": {
        "merge": true,
        "squash": true,
        "rebase": true
      },
      "mergeCommit": {
        "title": "merge-message",
        "message": "pull-request-title"
      },
      "squashMerge": {
        "title": "commit-or-pull-request-title",
        "message": "commit-messages"
      },
      "autoDeleteHeadBranch": true,
      "autoMerge": false,
      "allowUpdateBranch": false,
      "webCommitSignoffRequired": false
    },
    "security": {
      "vulnerabilityAlerts": true,
      "dependabotSecurityUpdates": false,
      "secretScanning": true,
      "pushProtection": true
    },
    "rulesets": {
      "defaultBranch": {
        "enforcement": "active",
        "blockDeletions": true,
        "blockForcePushes": true,
        "requireLinearHistory": false,
        "requireSignedCommits": true,
        "requirePullRequest": false,
        "requiredStatusChecks": [],
        "requireBranchesToBeUpToDate": false
      }
    },
    "actions": {
      "enabled": true,
      "allowedActions": "all",
      "shaPinningRequired": false,
      "defaultWorkflowPermissions": "read",
      "canApprovePullRequestReviews": false,
      "artifactRetentionDays": 7
    },
    "labels": [
      {
        "name": "bug",
        "color": "d73a4a",
        "description": "Something isn't working"
      },
      {
        "name": "documentation",
        "color": "0075ca",
        "description": "Improvements or additions to documentation"
      },
      {
        "name": "duplicate",
        "color": "cfd3d7",
        "description": "This issue or pull request already exists"
      },
      {
        "name": "enhancement",
        "color": "a2eeef",
        "description": "New feature or request"
      },
      {
        "name": "good first issue",
        "color": "7057ff",
        "description": "Good for newcomers"
      },
      {
        "name": "help wanted",
        "color": "008672",
        "description": "Extra attention is needed"
      },
      {
        "name": "invalid",
        "color": "e4e669",
        "description": "This doesn't seem right"
      },
      {
        "name": "question",
        "color": "d876e3",
        "description": "Further information is requested"
      },
      {
        "name": "wontfix",
        "color": "ffffff",
        "description": "This will not be worked on"
      }
    ],
    "issueTemplate": {
      "bugReportFields": [
        "web",
        "screenshots"
      ]
    }
  },
  "workflows": [
    {
      "template": "check-sponsor-gated-issues",
      "name": "sponsor-check",
      "triggers": [
        "issue-comment",
        "issues"
      ],
      "runsOn": "ubuntu-24.04",
      "timeoutMinutes": 5
    },
    {
      "template": "lock-inactive-issues",
      "name": "lock-inactive",
      "triggers": [
        "schedule-weekly"
      ],
      "runsOn": "ubuntu-24.04",
      "timeoutMinutes": 5
    },
    {
      "template": "publish",
      "name": "project",
      "triggers": [
        "release"
      ],
      "runsOn": "ubuntu-24.04",
      "timeoutMinutes": 30,
      "build": [
        "./apps/website"
      ],
      "deploy": [
        {
          "to": "github-pages",
          "path": "./apps/website",
          "artifact": "website"
        }
      ]
    }
  ],
  "urls": {
    "homepage": "https://mrjackyliang.github.io/mrjackyliang/",
    "repository": "git+https://github.com/mrjackyliang/mrjackyliang.git",
    "bugs": "https://github.com/mrjackyliang/mrjackyliang/issues",
    "license": "https://github.com/mrjackyliang/mrjackyliang/blob/HEAD/LICENSE",
    "fundSources": [
      "https://github.com/sponsors/mrjackyliang",
      "https://liang.nyc/paypal"
    ],
    "privacyPolicy": "https://mrjackyliang.github.io/mrjackyliang/privacy/",
    "termsOfUse": "https://mrjackyliang.github.io/mrjackyliang/terms/"
  },
