  "workspaces": {
    "./": {
      "name": "mrjackyliang-project",
      "role": "project",
      "policy": "freezable"
    },
    "./apps/website": {
      "name": "mrjackyliang-app-website",
      "role": "app",
      "policy": "trackable"
    }
  },
  "artifacts": {
    "website": {
      "build": [
        "./apps/website"
      ],
      "sources": [
        {
          "from": "./apps/website/build",
          "to": "./"
        }
      ]
    }
  },
  "ignoreFiles": {
    "./.gitignore": {
      "bundles": [
        "nova"
      ],
      "patterns": [
        "/assets/",
        ".turbo/",
        "graphify-out/"
      ]
    }
  },
  "attributeFiles": {
    "./.gitattributes": {
      "bundles": [],
      "patterns": [
        "*.applescript filter=applescript text diff",
        "*.scpt binary"
      ]
    }
  },
  "agents": [
    "claude-code",
    "codex"
  ],
  "recipes": {
    "github": {
      "sync-actions": {
        "enabled": true
      },
      "sync-features": {
        "enabled": true
      },
      "sync-identity": {
        "enabled": true
      },
      "sync-labels": {
        "enabled": true
      },
      "sync-policies": {
        "enabled": true
      },
      "sync-rulesets": {
        "enabled": true
      },
      "sync-security": {
        "enabled": true
      }
    },
    "license": {
      "update-copyright": {
        "enabled": true
      }
    },
    "miscellaneous": {
      "fix-markdown-tables": {
        "enabled": true
      },
      "remove-operating-system-files": {
        "enabled": true,
        "settings": {
          "linux": {},
          "macos": {
            "appleDouble": true,
            "desktopServicesStore": true
          },
          "windows": {
            "enhancedThumbnailDatabase": true,
            "enhancedVistaThumbnailDatabase": true,
            "thumbnailDatabase": true
          }
        }
      }
    },
    "nova-config": {
      "normalize-order": {
        "enabled": true
      }
    },
    "read-me": {
      "update-badges": {
        "enabled": true
      },
      "update-credits": {
        "enabled": true
      },
      "update-documentation": {
        "enabled": true
      },
      "update-header": {
        "enabled": true
      },
      "update-introduction": {
        "enabled": true
      }
    },
    "tsconfig": {
      "sync-references": {
        "enabled": true
      }
    },
    "package-json": {
      "./": {
        "cleanup": {
          "enabled": true,
          "settings": {
            "removeUnknownKeys": true,
            "reorderKeys": true
          }
        },
        "normalize-artifacts": {
          "enabled": true
        },
        "normalize-bundler": {
          "enabled": true
        },
        "normalize-dependencies": {
          "enabled": true,
          "settings": {
            "pinDependencyVersions": true,
            "pinDevDependencyVersions": true
          }
        },
        "normalize-modules": {
          "enabled": true
        },
        "normalize-tooling": {
          "enabled": true
        },
        "sync-environment": {
          "enabled": true,
          "settings": {
            "trackNodeLtsVersions": true
          }
        },
        "sync-identity": {
          "enabled": true
        },
        "sync-ownership": {
          "enabled": true
        }
      },
      "./apps/website": {
        "cleanup": {
          "enabled": true,
          "settings": {
            "removeUnknownKeys": true,
            "reorderKeys": true
          }
        },
        "normalize-artifacts": {
          "enabled": true
        },
        "normalize-bundler": {
          "enabled": true
        },
        "normalize-dependencies": {
          "enabled": true,
          "settings": {
            "pinDependencyVersions": true,
            "pinDevDependencyVersions": true
          }
        },
        "normalize-modules": {
          "enabled": true
        },
        "normalize-tooling": {
          "enabled": true
        },
        "sync-environment": {
          "enabled": true,
          "settings": {
            "trackNodeLtsVersions": true
          }
        },
        "sync-identity": {
          "enabled": true
        },
        "sync-ownership": {
          "enabled": true
        }
      }
    }
  },
  "environment": {
    "project": {
      "prefix": "PROJECT_"
    },
    "workspaces": {
      "./": {
        "prefix": "ROOT_"
      },
      "./apps/website": {
        "prefix": "WEBSITE_"
      }
    },
    "workflows": {
      "sponsor-check": {
        "prefix": "SGS_"
      }
    }
  },
  "settings": {
    "coverage": {
      "minimum": 65
    },
    "lockStepVersioning": true,
    "runWorkspaces": {
      "cache": {
        "enabled": true,
        "directory": "./node_modules/.cache/nova/run-workspaces",
        "scripts": [
          "build",
          "check"
        ]
      },
      "concurrency": {
        "build": 2,
        "check": 2,
        "deploy": 2
      }
    },
    "versionStrategy": "semver"
  }
}
